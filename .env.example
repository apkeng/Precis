# URL of the Précis backend (precis-backend). Leave unset to run the reader
# app on the built-in sample data. Required for the admin panel (/admin).
VITE_API_URL=http://localhost:8000

# Admin panel sign-in uses the Précis Firebase project (newsdigest-9fd33),
# built into src/admin/firebase.ts. Set these only to point at another
# project, e.g. staging; VITE_FIREBASE_PROJECT_ID must then match the
# backend's FIREBASE_PROJECT_ID.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# Only a hint for Google's account picker; the backend enforces the domain.
# VITE_ADMIN_EMAIL_DOMAIN=apokryfon.com
