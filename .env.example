# URL of the Précis backend (precis-backend). Leave unset to run the reader
# app on the built-in sample data. Required for the admin panel (/admin).
VITE_API_URL=http://localhost:8000

# Admin panel sign-in (Firebase Authentication with the Google provider).
# Values come from the Firebase console: Project settings > Your apps > Web app.
# They identify the project and are not secrets. VITE_FIREBASE_PROJECT_ID must
# match the backend's FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Only a hint for Google's account picker; the backend enforces the domain.
VITE_ADMIN_EMAIL_DOMAIN=apokryfon.com
